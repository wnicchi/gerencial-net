<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Reescritura: si el archivo/carpeta no existe, lo maneja Laravel (index.php).
         Los assets reales (js, css, imágenes) los sirve IIS directamente. -->
    <rewrite>
      <rules>
        <rule name="Laravel Front Controller" stopProcessing="true">
          <match url="^(.*)$" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <!-- Para la raíz "/", que entre por Laravel (luego sirve la SPA) -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- Tipos MIME que faltan en Server 2012 R2 (fuentes) -->
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- Permitir subidas de hasta 50 MB (documentos, fotos) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- Los archivos de /assets tienen un hash único en el nombre (cambian de nombre
       cuando cambia el contenido), así que se pueden cachear un año sin riesgo.
       El index.html, en cambio, se sirve sin caché desde Laravel (routes/web.php). -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
